# Copy to .env.local and fill in. Never commit real secrets.

# Public URL of the site (used for metadata / Open Graph links)
NEXT_PUBLIC_SITE_URL=https://www.example.org

# Paystack — online giving. Without the public key, the Give page shows
# bank-transfer details instead of a card checkout.
# Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
# Server-only. Used by /api/paystack/verify to confirm each payment.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Optional — every form submission (visit, prayer, connect, contact, events,
# ministries, fellowships, newsletter, giving) is POSTed here as JSON.
# Point at Zapier/Make, a Google Apps Script, Slack workflow or your CRM.
SUBMISSIONS_WEBHOOK_URL=
